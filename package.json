{
  "name": "mi-proyecto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:all": "concurrently --kill-others-on-fail --names backend,frontend \"npm --prefix hflow-backend ci\" \"npm --prefix hflow-frontend ci\"",
    "build:backend": "npm --prefix hflow-backend run prisma:generate && npm --prefix hflow-backend run build",
    "build:frontend": "npm --prefix hflow-frontend run build",
    "build:all": "concurrently --kill-others-on-fail --names backend,frontend \"npm run build:backend\" \"npm run build:frontend\"",
    "build": "next build",
    "start:backend": "npm --prefix hflow-backend start",
    "start:frontend": "node -e \"process.env.PORT='3001';require('./hflow-frontend/.next/standalone/server.js')\"",
    "start:all": "concurrently --kill-others --names backend,frontend \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "next start",
    "predev": "node scripts/check-env.ts",
    "dev": "next dev",
    "prebuild": "node scripts/check-env.ts",
    "prestart": "node scripts/check-env.ts",
    "check-env": "node scripts/check-env.ts",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "render:video": "node src/remotion/render.mjs",
    "lint": "eslint",
    "test": "jest"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.59.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.540",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest": "^30.5.2",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
