POSTGRES_DB=hflow
POSTGRES_USER=hflow
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required by the root Next.js app and its Supabase-backed athlete portal.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
GROQ_API_KEY=replace-with-your-groq-api-key

# Used by hflow-frontend; /api is proxied to the backend on port 3000.
NEXT_PUBLIC_API_URL=/api
# Build-time URL used by the Next.js server-side proxy.
BACKEND_INTERNAL_URL=http://backend:3000
FRONTEND_URL=http://localhost:3001
# Comma-separated browser origins permitted for direct API access.
FRONTEND_ORIGINS=http://localhost:3001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_LANGUAGE_CODE=es
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.82
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEED=0.98
ELEVENLABS_USE_SPEAKER_BOOST=true

# Public HTTPS URL required by Instagram to download rendered MP4 videos.
MARKETING_MEDIA_PUBLIC_URL=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v22.0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3001/billing/success
STRIPE_CANCEL_URL=http://localhost:3001/pricing

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=H-Flow <no-reply@example.com>
PASSWORD_RESET_URL=http://localhost:3001/reset-password
