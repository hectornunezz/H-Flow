# Prefer the same-origin proxy ("/api") so the browser talks to Next.js on :3001
# and Next rewrites to BACKEND_INTERNAL_URL (default http://localhost:3000).
NEXT_PUBLIC_API_URL="/api"

# Optional absolute backend origin. Used when NEXT_PUBLIC_API_URL is unset.
# The client appends "/api" automatically if missing.
# NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
# API_URL="http://localhost:5000"

BACKEND_INTERNAL_URL="http://localhost:3000"
NEXT_PUBLIC_ENABLE_PAYMENTS=false
